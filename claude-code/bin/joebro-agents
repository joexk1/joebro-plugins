#!/usr/bin/env python3
"""joebro-agents: link your coding agents to JoeBro, and build JoeBro plugins.

One stdlib-only file (Python 3.9+) that is, depending on how it is called:

  joebro-agents link <url> --token-file F     point this computer at your JoeBro backend
  joebro-agents status                        is it linked, is JoeBro reachable
  joebro-agents install [--claude --codex --opencode --agy]  add the hooks to your agents
  joebro-agents report <claude|codex|opencode|agy>           (hook) report one event, hand over queued messages
  joebro-agents mcp                           MCP server: drive coding agents + build plugins
  joebro-agents ping "message" [--title T]    ping your phone through JoeBro
  joebro-agents agents                        list the coding agents JoeBro can see
  joebro-agents brief                         this repo's Shared Memory brief (what a session starts with)
  joebro-agents memory import [--write] [--include-instructions] [--global]   move learned agent memory into Shared Memory; CLAUDE.md / AGENTS.md instructions stay
  joebro-agents memory mirror                 write .joebro/memory/MEMORY.md for this repo
  joebro-agents node tick|run [--every 60] [--dry-run]  run Night Shift tasks / start sessions for repos on THIS computer
  joebro-agents plugin init|push|list|spec|source|test|rollback ...

Aliases by file name (symlinks): joebro-agent-report = report, joebro-agents-mcp = mcp,
joebro-plugin = plugin, joebro-ping = ping.

Config: ~/.config/joebro/agents.json {"url","token","host"} (mode 0600), or env
JOEBRO_URL / JOEBRO_TOKEN / JOEBRO_HOST. Hooks never block an agent and never
print unless they are handing over a message.
"""
import json
import os
import re
import shutil
import socket
import stat
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

VERSION = "1.0.0"
HOME = os.path.expanduser("~")
CONFIG = os.path.join(HOME, ".config", "joebro", "agents.json")
LEGACY_CONFIG = os.path.join(HOME, ".config", "joebro", "agent-report.json")
DEFAULT_URL = "http://127.0.0.1:8771"


# ----------------------------------------------------------------------------- config / http
def default_host():
    name = (socket.gethostname() or "computer").split(".")[0].lower()
    return re.sub(r"[^a-z0-9-]", "-", name)[:30].strip("-") or "computer"


def config():
    cfg = {}
    for path in (CONFIG, LEGACY_CONFIG):
        try:
            with open(path) as f:
                cfg = json.load(f)
            break
        except (OSError, ValueError):
            continue
    url = os.environ.get("JOEBRO_URL") or cfg.get("url") or DEFAULT_URL
    token = os.environ.get("JOEBRO_TOKEN") or cfg.get("token") or ""
    host = os.environ.get("JOEBRO_HOST") or cfg.get("host") or default_host()
    return {"url": url.rstrip("/"), "token": token, "host": host, "linked": bool(cfg) or bool(os.environ.get("JOEBRO_URL"))}


def api(method, path, body=None, timeout=60, cfg=None):
    cfg = cfg or config()
    headers = {"Content-Type": "application/json"}
    if cfg["token"]:
        headers["Authorization"] = "Bearer " + cfg["token"]
    req = urllib.request.Request(cfg["url"] + path, method=method, headers=headers,
                                 data=json.dumps(body).encode() if body is not None else None)
    try:
        return json.loads(urllib.request.urlopen(req, timeout=timeout).read() or b"{}")
    except urllib.error.HTTPError as e:
        try:
            detail = json.loads(e.read()).get("detail")
        except Exception:
            detail = None
        return {"ok": False, "error": detail or "HTTP %d" % e.code}
    except Exception as e:
        return {"ok": False, "error": "JoeBro is not reachable at %s (%s)" % (cfg["url"], e)}


def q(s):
    return urllib.parse.quote(str(s), safe=":")


def clip(v, n=200):
    return re.sub(r"\s+", " ", str(v or "")).strip()[:n]


def detect_harness():
    env = os.environ
    if env.get("JOEBRO_HARNESS"):       # set by the MCP registration: Codex strips its own env vars
        return env["JOEBRO_HARNESS"]
    if env.get("CLAUDECODE") or env.get("CLAUDE_CODE_ENTRYPOINT"):
        return "claude"
    if any(k.startswith("CODEX_") for k in env):
        return "codex"
    if env.get("OPENCODE") or any(k.startswith("OPENCODE_") for k in env):
        return "opencode"
    if env.get("ANTIGRAVITY_AGENT") or any(k.startswith("ANTIGRAVITY_") for k in env):
        return "agy"
    return "agent"


# ----------------------------------------------------------------------------- hook reporter
SPAWN_TOOLS = ("spawn_agent", "spawn_agents", "Task", "Agent", "invoke_subagent")
CLAUDE_MAP = {"SessionStart": "start", "UserPromptSubmit": "prompt", "PreToolUse": "tool", "PostToolUse": "tool_done",
              "PermissionRequest": "waiting", "Stop": "stop", "StopFailure": "stop", "SessionEnd": "end",
              "SubagentStart": "subagent_start", "SubagentStop": "subagent_stop"}


def tool_text(inp):
    if not isinstance(inp, dict):
        return clip(inp, 120)
    for k in ("toolSummary", "description", "Description", "command", "CommandLine", "file_path", "filePath",
              "path", "Path", "TargetFile", "AbsolutePath", "DirectoryPath", "pattern", "url", "query", "Query",
              "prompt", "Prompt", "Role"):
        if inp.get(k):
            v = str(inp[k])
            if k in ("file_path", "filePath", "path", "Path", "TargetFile", "AbsolutePath", "DirectoryPath"):
                v = os.path.basename(v.rstrip("/")) or v
            return clip(v, 120)
    return ""


def new_assistant_text(path, sid):
    """Every written (not tool) text in a Claude Code transcript since the last report, oldest first."""
    if not path or not os.path.isfile(str(path)):
        return ""
    try:
        with open(path, "rb") as f:
            f.seek(0, 2)
            f.seek(max(0, f.tell() - 262144))
            lines = f.read().decode("utf-8", "replace").splitlines()
    except OSError:
        return ""
    mark = os.path.join(os.path.expanduser("~/.cache/joebro-agents"), "said-" + re.sub(r"[^A-Za-z0-9_-]", "_", sid)[:80])
    try:
        seen = open(mark).read().strip()
    except OSError:
        seen = ""
    found, newest = [], ""
    for line in reversed(lines):
        try:
            row = json.loads(line)
        except ValueError:
            continue
        if row.get("type") == "user" and not isinstance((row.get("message") or {}).get("content"), list):
            break                          # reached the prompt
        if row.get("type") != "assistant":
            continue
        parts = [c.get("text", "") for c in (row.get("message") or {}).get("content") or []
                 if isinstance(c, dict) and c.get("type") == "text" and c.get("text", "").strip()]
        if not parts:
            continue
        uid = str(row.get("uuid") or hash(parts[-1]))
        if uid == seen:
            break                          # everything older was already reported
        newest = newest or uid
        found.append("\n\n".join(parts).strip())
    if not newest:
        return ""
    try:
        os.makedirs(os.path.dirname(mark), exist_ok=True)
        open(mark, "w").write(newest)
    except OSError:
        pass
    return "\n\n".join(reversed(found))


def _tail_lines(path, n=262144):
    try:
        with open(path, "rb") as f:
            f.seek(0, 2)
            f.seek(max(0, f.tell() - n))
            return f.read().decode("utf-8", "replace").splitlines()
    except OSError:
        return []


def codex_rollout(data):
    """Path of this Codex session's rollout file: transcript_path if the hook passes it, else found by session id."""
    p = data.get("transcript_path") or data.get("rollout_path")
    if p and os.path.isfile(str(p)):
        return str(p)
    sid = re.sub(r"[^A-Za-z0-9_-]", "", str(data.get("session_id") or data.get("thread_id") or ""))
    if not sid:
        return ""
    try:
        import glob
        hits = glob.glob(os.path.expanduser("~/.codex/sessions/*/*/*/rollout-*%s*.jsonl" % sid))
        return max(hits, key=os.path.getmtime) if hits else ""
    except Exception:
        return ""


def new_codex_text(path, sid):
    """Assistant messages in a Codex rollout (response_item/message/assistant) since the last report, oldest first."""
    if not path or not os.path.isfile(str(path)):
        return ""
    mark = os.path.join(os.path.expanduser("~/.cache/joebro-agents"), "said-" + re.sub(r"[^A-Za-z0-9_-]", "_", sid)[:80])
    try:
        seen = open(mark).read().strip()
    except OSError:
        seen = ""
    found, newest = [], ""
    for line in reversed(_tail_lines(path)):
        try:
            row = json.loads(line)
        except ValueError:
            continue
        pl = row.get("payload") if isinstance(row, dict) else None
        if not isinstance(pl, dict):
            continue
        if row.get("type") == "event_msg" and pl.get("type") == "user_message":
            break                          # reached the prompt
        if row.get("type") != "response_item" or pl.get("type") != "message" or pl.get("role") != "assistant":
            continue
        parts = [c.get("text", "") for c in pl.get("content") or []
                 if isinstance(c, dict) and c.get("type") in ("output_text", "text") and c.get("text", "").strip()]
        if not parts:
            continue
        uid = str(pl.get("id") or row.get("ordinal") or row.get("timestamp") or hash(parts[-1]))
        if uid == seen:
            break
        newest = newest or uid
        found.append("\n\n".join(parts).strip())
    if not newest:
        return ""
    try:
        os.makedirs(os.path.dirname(mark), exist_ok=True)
        open(mark, "w").write(newest)
    except OSError:
        pass
    return "\n\n".join(reversed(found))


def new_agy_text(path, sid):
    """Assistant messages in an Antigravity transcript (PLANNER_RESPONSE.content) since the last report, oldest first."""
    if not path or not os.path.isfile(str(path)):
        return ""
    mark = os.path.join(os.path.expanduser("~/.cache/joebro-agents"), "said-" + re.sub(r"[^A-Za-z0-9_-]", "_", sid)[:80])
    try:
        seen = open(mark).read().strip()
    except OSError:
        seen = ""
    found, newest = [], ""
    for line in reversed(_tail_lines(path)):
        try:
            row = json.loads(line)
        except ValueError:
            continue
        if not isinstance(row, dict):
            continue
        if row.get("type") == "USER_INPUT":
            break                          # reached the prompt
        if row.get("type") != "PLANNER_RESPONSE":
            continue
        txt = str(row.get("content") or "").strip()
        if not txt:
            continue
        uid = str(row.get("step_index") if row.get("step_index") is not None else row.get("created_at") or hash(txt))
        if uid == seen:
            break
        newest = newest or uid
        found.append(txt)
    if not newest:
        return ""
    try:
        os.makedirs(os.path.dirname(mark), exist_ok=True)
        open(mark, "w").write(newest)
    except OSError:
        pass
    return "\n\n".join(reversed(found))


def said_since(source, data, sid):
    try:
        if source == "codex":
            return new_codex_text(codex_rollout(data), sid)
        if source == "agy":
            return new_agy_text(data.get("transcriptPath") or data.get("transcript_path"), sid)
        return new_assistant_text(data.get("transcript_path"), sid)
    except Exception:
        return ""


LIMIT_RX = re.compile(r"usage limit|rate.?limit|limit reached|hit your limit|reached your limit|resets? (at|in|on)\b|resets \d|"
                      r"overloaded|credit balance|quota|insufficient[_ ]funds|too many requests|\b(429|529)\b|api error", re.I)


def limit_notice(text):
    """Short human line when text reads like a usage/rate limit or API error, else ''."""
    t = re.sub(r"\s+", " ", str(text or "")).strip()
    if not t or len(t) > 1500 or not LIMIT_RX.search(t):
        return ""
    m = re.search(r"resets?\s+(?:at\s+|in\s+|on\s+)?([^.|\n(]{1,40}?)(?:\s*\(|\.|\||$)", t, re.I)
    when = (" \u2014 resets " + m.group(1).strip()) if m else ""
    low = t.lower()
    if "credit balance" in low or "insufficient" in low:
        return "Credit balance too low" + when
    if "overloaded" in low or "529" in low:
        return "API overloaded, try again shortly"
    if "usage limit" in low or "limit reached" in low or "hit your limit" in low or "reached your limit" in low or "quota" in low:
        return "Usage limit reached" + when
    if "rate" in low or "too many" in low or "429" in low:
        return "Rate limited" + when
    return clip(t, 120)


def stop_notice(source, data):
    """Look for a limit/API error in the stop payload, its last message and the transcript tail."""
    try:
        cands = [data.get("error"), data.get("error_details"), data.get("stop_reason"), data.get("last_assistant_message")]
        for c in cands:
            if isinstance(c, (dict, list)):
                c = json.dumps(c)
            n = limit_notice(c)
            if n and (c is not cands[3] or len(str(c)) < 600):
                return n
        if source == "agy":
            reason = str(data.get("terminationReason") or "")
            if reason == "MAX_TOKEN_BUDGET_EXCEEDED":
                return "Token budget exceeded"
            if reason == "ERROR" and data.get("error"):
                return clip(data.get("error"), 120)
            return ""
        path = codex_rollout(data) if source == "codex" else data.get("transcript_path")
        if not path or not os.path.isfile(str(path)):
            return ""
        for line in reversed(_tail_lines(path, 65536)[-12:]):
            try:
                row = json.loads(line)
            except ValueError:
                continue
            pl = row.get("payload") if isinstance(row.get("payload"), dict) else {}
            if source == "codex":
                if row.get("type") == "event_msg" and pl.get("type") in ("error", "stream_error"):
                    return limit_notice(pl.get("message")) or clip(pl.get("message"), 120)
                if row.get("type") == "event_msg" and pl.get("type") in ("task_complete", "user_message"):
                    return ""
            else:
                msg = row.get("message") if isinstance(row.get("message"), dict) else {}
                if row.get("type") == "user" and not isinstance(msg.get("content"), list):
                    return ""
                if row.get("type") == "assistant" and (row.get("isApiErrorMessage") or row.get("error")):
                    txt = " ".join(c.get("text", "") for c in msg.get("content") or [] if isinstance(c, dict))
                    return limit_notice(txt) or limit_notice(row.get("error")) or clip(txt, 120)
        return ""
    except Exception:
        return ""


QUESTION_TOOLS = {"AskUserQuestion", "request_user_input", "question", "ask_question"}


def _is_print_mode(pid):
    """True when the enclosing harness process was launched non-interactively (-p/--print)."""
    try:
        args = open("/proc/%d/cmdline" % int(pid), "rb").read().split(b"\0")
        return any(a in (b"-p", b"--print", b"--prompt") for a in args[1:])
    except Exception:
        return False


def _ancestor_pid(target_comm):
    """Find the enclosing harness process PID when hooks run via sh -c (Linux /proc, else ppid)."""
    pid = os.getppid()
    for _ in range(8):
        try:
            comm = open("/proc/%d/comm" % pid).read().strip()
            if comm == target_comm:
                return pid
            stat_tail = open("/proc/%d/stat" % pid).read().rsplit(")", 1)[1].split()
            ppid = int(stat_tail[1])
            if ppid <= 1:
                break
            pid = ppid
        except Exception:
            break
    return os.getppid()


def _agy_continued(sid, set_to=None):
    """Track whether our Stop hook just continued this Antigravity turn so the ensuing
    PreInvocation does not re-report the previous user prompt as a duplicate."""
    if not sid:
        return False
    path = _nudge_path(sid)
    try:
        st = json.load(open(path))
    except Exception:
        st = {"work": 0, "saved": False, "nudged": False}
    prev = bool(st.get("continued"))
    if set_to is not None and bool(set_to) != prev:
        st["continued"] = bool(set_to)
        try:
            with open(path, "w") as f:
                json.dump(st, f)
        except Exception:
            pass
    return prev


def normalise(source, data):
    if source in ("claude", "codex"):
        name = data.get("hook_event_name") or data.get("event") or ""
        ev = CLAUDE_MAP.get(name)
        if name == "Notification":
            msg = str(data.get("message") or "")
            ev = "waiting" if "permission" in msg.lower() or "approv" in msg.lower() else None
        tname = str(data.get("tool_name") or "")
        if ev == "tool" and tname in QUESTION_TOOLS and not data.get("agent_id"):
            ev = "waiting"      # it's asking you something: the apps show the menu from its screen
        if not ev:
            return None
        out = {"event": ev, "session_id": data.get("session_id") or data.get("thread_id") or "",
               "cwd": data.get("cwd") or os.getcwd(), "model": data.get("model") or ""}
        # Live subagents (feature-api section 3). Claude Code tags SubagentStart/Stop and every hook fired INSIDE a
        # subagent with its own agent_id; session_id stays the parent's. Report the subagent under its own id.
        aid = str(data.get("agent_id") or "")
        if aid and aid != out["session_id"]:
            out.update(parent_session_id=out["session_id"], session_id=aid)
            if data.get("agent_type"):
                out["subagent_type"] = clip(data.get("agent_type"), 40)
        if ev == "subagent_stop":
            out["text"] = clip(data.get("last_assistant_message"), 4000)
        if ev == "stop" and not aid:
            # Everything written since the last report, not just the final message.
            said = said_since(source, data, out["session_id"])
            if said:
                out["said"] = clip(said, 4000)
            notice = stop_notice(source, data)
            if notice:
                out["notice"] = notice
        if ev == "tool" and source == "codex" and str(data.get("tool_name") or "") in SPAWN_TOOLS and not aid:
            # Codex (as far as we can tell) sends no SubagentStart: the spawn tool call is the only signal, and there is
            # no stop signal, so the child is closed with its parent's turn (ends_with_parent).
            ti = data.get("tool_input") if isinstance(data.get("tool_input"), dict) else {}
            out["also"] = [{"event": "subagent_start", "session_id": "%s:sub:%s" % (out["session_id"], data.get("tool_use_id") or int(time.time() * 1000)),
                            "parent_session_id": out["session_id"], "subagent_type": clip(ti.get("agent_type") or ti.get("agent") or "subagent", 40),
                            "name": clip(ti.get("name") or ti.get("message") or ti.get("prompt"), 80), "ends_with_parent": True,
                            "cwd": out["cwd"]}]
        if ev == "prompt":
            out["text"] = clip(data.get("prompt"), 4000)
        elif ev == "tool":
            out["tool"] = clip(data.get("tool_name"), 60)
            out["text"] = tool_text(data.get("tool_input"))
            said = said_since(source, data, out["session_id"])
            if said:
                out["said"] = clip(said, 4000)      # what the agent wrote before this tool call, shown as its reply
            else:
                out["_recheck"] = (codex_rollout(data) if source == "codex" else data.get("transcript_path")) or ""   # text often lands in the transcript just after this hook
        elif ev == "tool_done":
            said = said_since(source, data, out["session_id"])
            if said:
                out["said"] = clip(said, 4000)
        elif ev == "waiting" and tname in QUESTION_TOOLS:
            ti = data.get("tool_input") if isinstance(data.get("tool_input"), dict) else {}
            qs = ti.get("questions") if isinstance(ti.get("questions"), list) else []
            q = (qs[0].get("question") if qs and isinstance(qs[0], dict) else "") or ti.get("question") or ti.get("prompt") or "a question"
            out["text"] = clip("Question: " + str(q), 160)
        elif ev == "waiting":
            out["text"] = clip(data.get("message") or ("approve " + str(data.get("tool_name") or "")), 160)
        elif ev == "stop":
            out["text"] = clip(data.get("last_assistant_message"), 4000)
        return out
    if source == "agy":
        name = data.get("hookEventName") or data.get("hook_event_name") or data.get("event") or ""
        sid = str(data.get("conversationId") or data.get("session_id") or "")
        wpaths = data.get("workspacePaths") if isinstance(data.get("workspacePaths"), list) else []
        cwd = data.get("cwd") or (wpaths[0] if wpaths else "") or os.getcwd()
        model = data.get("modelName") or data.get("model") or ""
        tc = data.get("toolCall") if isinstance(data.get("toolCall"), dict) else {}
        tname = str(tc.get("name") or data.get("tool_name") or "")
        targs = tc.get("args") if isinstance(tc.get("args"), dict) else (data.get("tool_input") if isinstance(data.get("tool_input"), dict) else {})
        tpath = data.get("transcriptPath") or data.get("transcript_path") or ""
        out = {"session_id": sid, "cwd": cwd, "model": model}
        if name == "SessionStart":
            out["event"] = "start"
            return out
        if name == "PreInvocation":
            inv = int(data.get("invocationNum") or 0)
            if inv == 0:
                if _agy_continued(sid, set_to=False):
                    out.update(event="prompt", _skip_post=True)
                else:
                    out.update(event="prompt", text=clip(data.get("lastUserInput"), 4000))
                return out
            out["event"] = "pre_invocation"
            return out
        if name == "PreToolUse":
            if tname in QUESTION_TOOLS:
                qs = targs.get("questions") if isinstance(targs.get("questions"), list) else []
                q = (qs[0].get("question") if qs and isinstance(qs[0], dict) else "") or targs.get("question") or targs.get("prompt") or "a question"
                out.update(event="waiting", text=clip("Question: " + str(q), 160))
                return out
            out.update(event="tool", tool=clip(tname, 60), text=tool_text(targs))
            said = said_since("agy", data, sid)
            if said:
                out["said"] = clip(said, 4000)
            elif tpath:
                out["_recheck"] = tpath
            if tname in SPAWN_TOOLS:
                out["also"] = [{"event": "subagent_start",
                                "session_id": "%s:sub:%s" % (sid, tc.get("id") or int(time.time() * 1000)),
                                "parent_session_id": sid,
                                "subagent_type": clip(targs.get("TypeName") or targs.get("agent_type") or "subagent", 40),
                                "name": clip(targs.get("Role") or targs.get("name") or targs.get("Prompt"), 80),
                                "ends_with_parent": True, "cwd": cwd}]
            return out
        if name == "PostToolUse":
            out["event"] = "tool_done"
            said = said_since("agy", data, sid)
            if said:
                out["said"] = clip(said, 4000)
            return out
        if name == "Stop":
            out["event"] = "stop"
            said = said_since("agy", data, sid)
            if said:
                out["said"] = clip(said, 4000)
            notice = stop_notice("agy", data)
            if notice:
                out["notice"] = notice
            return out
        if name == "SessionEnd":
            out["event"] = "end"
            return out
        return None
    if source == "opencode":   # the opencode plugin already normalises
        return data if data.get("event") else None
    return None


def pull(cfg, host, source, sid, via):
    """Queued instructions for this agent (fast; never holds a turn for long)."""
    qs = urllib.parse.urlencode({"host": host, "source": source, "session_id": sid, "via": via})
    try:
        req = urllib.request.Request(cfg["url"] + "/api/coding-agents/inbox?" + qs,
                                     headers={"Authorization": "Bearer " + cfg["token"]} if cfg["token"] else {})
        return json.loads(urllib.request.urlopen(req, timeout=1.5).read()).get("messages") or []
    except Exception:
        return []


def handover_text(msgs):
    # Exactly what was typed, like a message sent in the terminal.
    return "\n\n".join(str(m.get("text") or "") for m in msgs)


def cmd_report(source):
    cfg = config()
    if not cfg["linked"]:
        return 0                     # not linked: do nothing at all
    try:
        raw = sys.stdin.read() if not sys.stdin.isatty() else ""
        data = json.loads(raw) if raw.strip() else {}
    except Exception:
        return 0
    ev = normalise(source, data) if isinstance(data, dict) else None
    if not ev or not ev.get("session_id"):
        return 0
    ev.update(source=source, host=cfg["host"])
    # Command channel: instructions queued for THIS agent are handed over here.
    # Stop -> Claude/Codex carry on with them (decision:block + reason); Antigravity uses decision:continue + reason.
    # PostToolUse (Claude) / PreInvocation (Antigravity) -> delivered mid-turn within one tool step.
    deliver = ("stop", "prompt", "tool_done") if source == "claude" else ("stop", "prompt", "pre_invocation") if source == "agy" else ("stop", "prompt")
    nudge = nudge_track(source, data, ev) if source in ("claude", "codex", "agy") else ""
    handed = False
    if source in ("claude", "codex", "agy") and ev["event"] in deliver and not ev.get("parent_session_id"):
        msgs = pull(cfg, cfg["host"], source, ev["session_id"],
                    {"stop": "stop_hook", "prompt": "prompt_hook"}.get(ev["event"], "tool_hook"))
        if msgs:
            handed = True
            text = handover_text(msgs)
            if source == "agy":
                if ev["event"] == "stop":
                    sys.stdout.write(json.dumps({"decision": "continue", "reason": text}))
                    _agy_continued(ev["session_id"], set_to=True)
                    ev.update(event="prompt", text=clip(text, 4000))
                else:
                    sys.stdout.write(json.dumps({"injectSteps": [{"userMessage": text}]}))
                    if ev["event"] == "pre_invocation" or ev.get("_skip_post"):
                        ev.pop("_skip_post", None)
                        ev.update(event="prompt", text=clip(text, 4000))
            elif ev["event"] == "tool_done":
                sys.stdout.write(json.dumps({
                                             "hookSpecificOutput": {"hookEventName": "PostToolUse", "additionalContext": text}}))
                ev.update(event="prompt", text=clip(text, 4000))
            elif ev["event"] == "stop":
                sys.stdout.write(json.dumps({"decision": "block", "reason": text}))
                ev.update(event="prompt", text=clip(text, 4000))
            else:
                sys.stdout.write(json.dumps({
                                             "hookSpecificOutput": {"hookEventName": "UserPromptSubmit", "additionalContext": text}}))
            sys.stdout.flush()
    if nudge and not handed and ev["event"] == "stop":
        if source == "agy":
            sys.stdout.write(json.dumps({"decision": "continue", "reason": nudge}))
            _agy_continued(ev["session_id"], set_to=True)
        else:
            sys.stdout.write(json.dumps({"decision": "block", "reason": nudge}))
        sys.stdout.flush()
    also = ev.pop("also", [])
    if source in ("claude", "codex", "agy") and ev["event"] == "start" and memory_on(cfg):
        text = session_context(ev.get("cwd") or os.getcwd(), cfg, timeout=1.5)   # once per session: guide + <= 400-token brief
        if text:
            if source == "agy":
                sys.stdout.write(json.dumps({"injectSteps": [{"systemMessage": {"systemMessage": text}}]}))
            else:
                sys.stdout.write(json.dumps({"hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": text}}))
            sys.stdout.flush()
    if ev["event"] == "pre_invocation" or ev.pop("_skip_post", False):
        return 0
    if ev["event"] in ("stop", "end") and not ev.get("branch"):
        ev["branch"] = _git(ev.get("cwd") or os.getcwd(), "symbolic-ref", "--short", "-q", "HEAD")
    if os.environ.get("JOEBRO_NIGHT_TASK"):
        ev["night_task"] = os.environ["JOEBRO_NIGHT_TASK"]
    ev.setdefault("pid", _ancestor_pid("agy") if source == "agy" else os.getppid())
    in_tmux = bool(os.environ.get("TMUX_PANE"))
    print_run = _is_print_mode(ev["pid"])
    for env, key in (("KITTY_WINDOW_ID", "kitty_window_id"), ("KITTY_LISTEN_ON", "kitty_listen_on"),
                     ("TMUX_PANE", "tmux_pane"), ("TERM_PROGRAM", "term")):
        # Inside tmux, Kitty variables are inherited from whichever terminal started the
        # tmux server: they'd point at someone else's window, so they're not ours to report.
        # Non-interactive (-p/--print) runs also inherit an enclosing terminal without owning it.
        if print_run and env in ("KITTY_WINDOW_ID", "KITTY_LISTEN_ON", "TMUX_PANE"):
            continue
        if in_tmux and env.startswith("KITTY_"):
            continue
        if os.environ.get(env) and not ev.get(key):
            ev[key] = os.environ[env]
    try:                               # detach: the harness never waits on the network
        if os.fork():
            return 0
        os.setsid()
        if os.fork():
            os._exit(0)
        devnull = os.open(os.devnull, os.O_RDWR)
        for fd in (0, 1, 2):
            os.dup2(devnull, fd)
    except (OSError, AttributeError):
        pass
    recheck = ev.pop("_recheck", "")
    for e in [ev] + [dict(x, source=source, host=cfg["host"], pid=ev["pid"]) for x in also]:
        api("POST", "/api/coding-agents/event", e, timeout=4, cfg=cfg)
    if recheck:
        time.sleep(1.5)
        said = new_codex_text(recheck, ev["session_id"]) if source == "codex" else new_agy_text(recheck, ev["session_id"]) if source == "agy" else new_assistant_text(recheck, ev["session_id"])
        if said:
            api("POST", "/api/coding-agents/event", {"event": "tool_done", "session_id": ev["session_id"], "source": source,
                                                      "host": cfg["host"], "said": clip(said, 4000), "pid": ev["pid"],
                                                      "cwd": ev.get("cwd", "")}, timeout=4, cfg=cfg)
    os._exit(0)


def cmd_pull(argv):
    cfg = config()
    if len(argv) < 2 or not cfg["linked"]:
        sys.stdout.write("[]")
        return 0
    sys.stdout.write(json.dumps(pull(cfg, cfg["host"], argv[0], argv[1], "plugin")))
    return 0


# ----------------------------------------------------------------------------- shared memory + night shift
def _git(cwd, *args):
    try:
        import subprocess
        p = subprocess.run(["git", "-C", cwd, *args], capture_output=True, text=True, timeout=3)
        return p.stdout.strip() if p.returncode == 0 else ""
    except Exception:
        return ""


def project_ctx(cwd=None):
    """Which project this is: the main checkout's path and its origin remote (worktrees share their repo's memory)."""
    cwd = cwd or os.getcwd()
    top = _git(cwd, "rev-parse", "--show-toplevel") or cwd
    common = _git(cwd, "rev-parse", "--path-format=absolute", "--git-common-dir")
    if common.endswith("/.git"):
        top = common[:-5]
    return {"path": top, "remote": _git(cwd, "remote", "get-url", "origin"), "project_name": os.path.basename(top.rstrip("/"))}


def memory_on(cfg=None):
    return os.environ.get("JOEBRO_MEMORY", "").lower() not in ("off", "0", "false")


def provenance(cfg=None):
    cfg = cfg or config()
    return {"agent": detect_harness(), "host": cfg["host"], "source": "mcp",
            "model": os.environ.get("JOEBRO_MODEL") or os.environ.get("ANTHROPIC_MODEL") or "",
            "session": os.environ.get("CLAUDE_SESSION_ID") or os.environ.get("ANTIGRAVITY_CONVERSATION_ID") or os.environ.get("JOEBRO_NIGHT_TASK") or ""}


def brief_text(cwd=None, cfg=None, timeout=4):
    d = api("GET", "/api/shared-memory/brief?" + urllib.parse.urlencode(project_ctx(cwd)), timeout=timeout, cfg=cfg)
    return d.get("brief") or ""


# Told to every session at start, with or without a brief: the tools alone are not enough,
# agents only use memory they are asked to use.
MEMORY_GUIDE = (
    "JoeBro Shared Memory is on for this project, shared with every other coding agent on it. "
    "Before guessing how this repo does something, call memory_recall. "
    "The moment you learn something durable, save it with memory_remember, one sentence each: "
    "a decision and why, a gotcha, a fix that worked, an approach that failed, a fact about the "
    "build or environment. Don't save progress notes, summaries, instructions or secrets.")


def session_context(cwd=None, cfg=None, timeout=4):
    """What a session starts with: the guide, then this project's brief if it has one."""
    brief = brief_text(cwd, cfg, timeout=timeout)
    return MEMORY_GUIDE + ("\n\n" + brief if brief else "")


# ---- the save nudge: once per session, at Stop, if it did real work and saved nothing ----
NUDGE_MIN_WORK = 3
WORK_TOOLS = {"Edit", "Write", "MultiEdit", "NotebookEdit", "Bash", "apply_patch", "shell", "exec_command", "write_stdin",
              "run_command", "write_file", "edit_file", "write_to_file", "replace_file_content", "multi_replace_file_content"}
NUDGE_TEXT = (
    "Before you finish: did you learn anything durable this session that the next session, or a "
    "different agent, should know? A decision and why, a gotcha, a fix that worked, an approach that "
    "failed. If so, save each one now with memory_remember (one sentence each), then stop. "
    "If there's nothing worth keeping, just stop. You won't be asked again this session.")


def _nudge_path(session_id):
    d = os.path.join(os.path.expanduser("~/.cache/joebro-agents"), "sessions")
    os.makedirs(d, exist_ok=True)
    return os.path.join(d, re.sub(r"[^A-Za-z0-9_.-]", "_", session_id)[:120] + ".json")


def nudge_track(source, data, ev):
    """Count real work and memory saves for this session. Returns the Stop nudge text or ''."""
    sid = ev.get("session_id") or ""
    if not sid or ev.get("parent_session_id") or not memory_on():
        return ""
    path = _nudge_path(sid)
    try:
        st = json.load(open(path))
    except Exception:
        st = {"work": 0, "saved": False, "nudged": False}
    tc = data.get("toolCall") if isinstance(data.get("toolCall"), dict) else {}
    tool = str(data.get("tool_name") or tc.get("name") or "")
    hook_ev = data.get("hook_event_name") or data.get("hookEventName") or ""
    changed = False
    if tool and ev["event"] in ("tool", "tool_done") and hook_ev == "PreToolUse":
        if "memory_remember" in tool or "memory_supersede" in tool:
            st["saved"] = True; changed = True
        elif tool in WORK_TOOLS:
            st["work"] += 1; changed = True
    out = ""
    continuing = bool(data.get("stop_hook_active") or data.get("continuationActive")
                      or (source == "agy" and int(data.get("executionNum") or 0) > 0))
    if ev["event"] == "stop" and not st["saved"] and not st["nudged"] and st["work"] >= NUDGE_MIN_WORK and not continuing:
        st["nudged"] = True; changed = True
        out = NUDGE_TEXT
    if changed:
        try:
            with open(path, "w") as f:
                json.dump(st, f)
        except Exception:
            pass
    if ev["event"] == "end":
        try:
            os.remove(path)
        except Exception:
            pass
    return out


def _fact(f):
    """A fact as an agent sees it: compact on purpose."""
    return {"id": f.get("id"), "text": f.get("text"), "topic": f.get("topic"), "strength": f.get("strength"),
            **({"status": f["status"]} if f.get("status") not in (None, "active") else {}),
            **({"scope": "global"} if f.get("scope") == "global" else {})}


def _mem(d, key="fact"):
    if d.get("ok") is False:
        return d
    return {"ok": True, key: _fact(d[key]), **({"outcome": d["outcome"]} if d.get("outcome") else {})}


def t_remember(a):
    body = dict(project_ctx(), **provenance(), text=a.get("text") or "", topic=a.get("topic") or "", kind=a.get("kind") or "fact")
    if a.get("scope") == "global":
        body = dict(provenance(), project="global", text=body["text"], topic=body["topic"], kind=body["kind"])
    return _mem(api("POST", "/api/shared-memory", body))


def t_recall(a):
    d = api("POST", "/api/shared-memory/recall", dict(project_ctx(), query=a.get("query") or "", limit=min(int(a.get("limit") or 5), 10),
                                                      include_archived=bool(a.get("include_archived"))))
    return d if d.get("ok") is False else {"facts": [_fact(f) for f in d.get("facts", [])]}


def t_supersede(a):
    return _mem(api("POST", "/api/shared-memory/%s/supersede" % q(a["id"]), dict(provenance(), text=a.get("text") or "", reason=a.get("reason") or "")))


def t_forget(a):
    return _mem(api("POST", "/api/shared-memory/%s/archive" % q(a["id"]), {"reason": a.get("reason") or "", "agent": detect_harness()}))


def t_brief(a):
    d = api("GET", "/api/shared-memory/brief?" + urllib.parse.urlencode(project_ctx()))
    return d if d.get("ok") is False else {"brief": d.get("brief"), "tokens": d.get("tokens")}


def _night(t):
    return {k: t.get(k) for k in ("id", "title", "status", "repo", "agent", "model", "branch", "error") if t.get(k)}


def t_night_add(a):
    body = {k: a[k] for k in ("prompt", "title", "agent", "model", "test_command", "window_start", "window_end", "max_minutes") if a.get(k)}
    body["repo"] = a.get("repo") or project_ctx()["path"]
    d = api("POST", "/api/night-shift", body)
    return d if d.get("ok") is False else {"ok": True, "task": _night(d["task"])}


def t_night_list(a):
    d = api("GET", "/api/night-shift")
    return d if d.get("ok") is False else {"tasks": [_night(t) for t in d.get("tasks", [])
                                                     if t.get("status") in ("queued", "running", "review", "failed")]}


def t_night_cancel(a):
    d = api("POST", "/api/night-shift/%s/cancel" % q(a["id"]), {})
    return d if d.get("ok") is False else {"ok": True, "task": _night(d["task"])}


# Instruction files (build commands, conventions, rules) stay where they are: --write only adds a
# short pointer block to CLAUDE.md and AGENTS.md. What moves into Shared Memory is the agents' own
# learned memory (Claude Code's auto-memory folder). --include-instructions also reads facts out of
# the instruction files, without changing them.
REPO_MEMORY_FILES = [("CLAUDE.md", "claude"), ("CLAUDE.local.md", "claude"), (".claude/CLAUDE.md", "claude"),
                     ("AGENTS.md", "codex"), ("AGENTS.override.md", "codex"), (".opencode/AGENTS.md", "opencode"),
                     ("GEMINI.md", "agy"), (".agents/rules/AGENTS.md", "agy")]
GLOBAL_MEMORY_FILES = [(".claude/CLAUDE.md", "claude"), (".codex/AGENTS.md", "codex"), (".config/opencode/AGENTS.md", "opencode"),
                       (".gemini/config/GEMINI.md", "agy")]
POINTER_FILES = ("CLAUDE.md", "AGENTS.md")
MEM_END = "<!-- joebro:memory:end -->"
MEM_MARK = "<!-- joebro:memory:start -->"


def _read(path):
    try:
        with open(path) as f:
            return f.read()
    except (OSError, UnicodeDecodeError):
        return ""


def strip_pointer(text):
    return re.sub(re.escape(MEM_MARK) + r".*?" + re.escape(MEM_END) + r"\n?", "", text, flags=re.S)


def memory_sources(top, is_global=False, instructions=False):
    """[(absolute path, agent, text)] for one repo (or the user-wide files with --global).
    Instruction files are included only when asked; learned memory always is."""
    out = []
    if is_global:
        cands = [(os.path.join(HOME, rel), agent) for rel, agent in GLOBAL_MEMORY_FILES] if instructions else []
    else:
        cands = [(os.path.join(top, rel), agent) for rel, agent in REPO_MEMORY_FILES] if instructions else []
        try:        # OpenCode rules listed in opencode.json
            for rel in (json.loads(_read(os.path.join(top, "opencode.json")) or "{}").get("instructions") or []) if instructions else []:
                if isinstance(rel, str) and "*" not in rel and "://" not in rel:
                    cands.append((os.path.join(top, rel), "opencode"))
        except ValueError:
            pass
    if not is_global:
        mem = os.path.join(HOME, ".claude", "projects", re.sub(r"[^A-Za-z0-9]", "-", top), "memory")   # Claude Code auto-memory
        if os.path.isdir(mem):
            cands += [(os.path.join(mem, n), "claude") for n in sorted(os.listdir(mem)) if n.endswith(".md")]
    seen = set()
    for path, agent in cands:
        real = os.path.realpath(path)
        text = strip_pointer(_read(path))
        if real in seen or not text.strip():
            continue
        seen.add(real)
        out.append((path, agent, text))
    return out


def cmd_memory(argv):
    cfg = config()
    sub = argv[0] if argv else ""
    ctx = project_ctx()
    top = ctx["path"]
    if sub == "mirror":
        d = api("GET", "/api/shared-memory/mirror?" + urllib.parse.urlencode(ctx), cfg=cfg)
        if d.get("ok") is False:
            sys.exit(d.get("error") or d.get("detail"))
        dest = os.path.join(top, ".joebro", "memory")
        os.makedirs(dest, exist_ok=True)
        for name, text in d["files"].items():
            with open(os.path.join(dest, os.path.basename(name)), "w") as f:
                f.write(text)
        print("wrote " + dest)
        return 0
    if sub != "import":
        sys.exit("usage: joebro-agents memory import [--write] [--include-instructions] [--global] | mirror")
    is_global, write = "--global" in argv, "--write" in argv
    sources = memory_sources(top, is_global, "--include-instructions" in argv)
    if not sources:
        print("No learned agent memory found%s. Instruction files (CLAUDE.md, AGENTS.md) are left as they are; "
              "--include-instructions also reads facts from them." % ("" if is_global else " for " + top))
        if write and not is_global:
            add_pointers(top, d=None, ctx=ctx, cfg=cfg)
        return 0
    body = dict({"project": "global"} if is_global else ctx, host=cfg["host"], agent="import",
                files=[{"path": p, "agent": agent, "text": text} for p, agent, text in sources])
    d = api("POST", "/api/shared-memory/import", body, cfg=cfg)
    if d.get("ok") is False:
        sys.exit(d.get("error") or d.get("detail"))
    print("Imported %d files (%d tokens): %d facts added, %d duplicates merged, %d skipped." % (
        d["files"], d["tokens_before"], d["added"], d["deduped"] + d["superseded"], d["skipped"]))
    print("  Each session now starts with a %d-token brief from Shared Memory." % d["brief_tokens"])
    learned = [x for x in sources if not x[0].startswith(top + os.sep)]
    if is_global or not write:
        print("Nothing on disk was changed.%s" % ("" if is_global else
              " Run again with --write to add a short Shared Memory pointer to CLAUDE.md and AGENTS.md"
              " (your instructions in them stay as they are)" + (" and move Claude Code's learned memory into Shared Memory:" if learned else ".")))
        for p, _, _ in learned:
            print("  " + p)
        return 0
    backup = os.path.join(top, ".joebro", "memory", "imported")
    os.makedirs(backup, exist_ok=True)
    for p, _, text in learned:          # only learned memory moves; originals are kept
        with open(os.path.join(backup, "claude-memory_" + os.path.basename(p)), "w") as f:
            f.write(text)
        os.replace(p, p + ".before-joebro")
    add_pointers(top, d, ctx, cfg)
    print("Added a Shared Memory pointer to CLAUDE.md and AGENTS.md; their instructions are unchanged."
          + (" Learned memory moved; originals: " + backup if learned else ""))
    return 0


def add_pointers(top, d, ctx, cfg):
    """Append (or refresh) the pointer block in CLAUDE.md and AGENTS.md, keeping everything else."""
    block = (d or {}).get("slim") or api("POST", "/api/shared-memory/import", dict(ctx, host=cfg["host"], agent="import", files=[]),
                                         cfg=cfg).get("slim", "")
    if not block:
        return
    for name in POINTER_FILES:
        path = os.path.join(top, name)
        old = strip_pointer(_read(path)).rstrip()
        with open(path, "w") as f:
            f.write((old + "\n\n" if old else "") + block)
    os.makedirs(os.path.join(top, ".joebro", "memory"), exist_ok=True)
    for name, text in (api("GET", "/api/shared-memory/mirror?" + urllib.parse.urlencode(ctx), cfg=cfg).get("files") or {}).items():
        with open(os.path.join(top, ".joebro", "memory", os.path.basename(name)), "w") as f:
            f.write(text)


# ----------------------------------------------------------------------------- tools (shared by MCP + CLI)
def slim(n):
    term = n.get("terminal") or {}
    return {"id": n["id"], "harness": n["source"], "host": n["host"], "project": n["name"], "cwd": n["cwd"],
            "status": n["status"], "needs_you": n.get("waiting", False), "tool_calls": n.get("tool_calls", 0),
            "last": (n.get("detail") or [""])[-1], "in_terminal": bool(term.get("kitty_window_id") or term.get("tmux_pane")),
            "last_activity": n.get("last_activity")}


def t_list(a):
    d = api("GET", "/api/coding-agents")
    if d.get("ok") is False:
        return d
    nodes = [slim(n) for n in d.get("nodes", [])]
    if a.get("harness"):
        nodes = [n for n in nodes if n["harness"] == a["harness"]]
    if a.get("host"):
        nodes = [n for n in nodes if n["host"] == a["host"]]
    return {"agents": nodes, "count": len(nodes), "busy": sum(n["status"] in ("running", "waiting") for n in nodes)}


def t_detail(a):
    d = api("GET", "/api/agents/" + q(a["id"]))
    return d.get("agent") or d


def t_screen(a):
    return api("GET", "/api/coding-agents/%s/screen?lines=%d" % (q(a["id"]), int(a.get("lines") or 60)))


def t_send(a):
    return api("POST", "/api/coding-agents/%s/send" % q(a["id"]),
               {"text": a["text"], "mode": a.get("mode") or "auto", "sender": a.get("sender") or "JoeBro"})


KEYS = {"approve": "y", "deny": "n", "interrupt": "escape", "force_stop": "ctrl+c", "enter": "enter",
        "option_1": "1", "option_2": "2", "option_3": "3", "up": "up", "down": "down", "cycle_mode": "shift+tab"}


def t_control(a):
    key = KEYS.get(a.get("action"))
    if not key:
        return {"ok": False, "error": "action must be one of " + ", ".join(KEYS)}
    return api("POST", "/api/coding-agents/%s/keys" % q(a["id"]), {"keys": key})


def t_launch(a):
    return api("POST", "/api/coding-agents/launch", {"host": a["host"], "harness": a["harness"],
                                                     "cwd": a.get("cwd") or "", "prompt": a.get("prompt") or ""}, timeout=90)


def t_wait(a):
    deadline = time.time() + max(5, min(int(a.get("timeout_s") or 300), 600))
    last = None
    while time.time() < deadline:
        d = api("GET", "/api/coding-agents")
        n = next((x for x in d.get("nodes", []) if x["id"] == a["id"]), None)
        if n is None:
            return {"id": a["id"], "status": "ended", "detail": "The agent's terminal closed."}
        last = slim(n)
        if n["status"] != "running":
            return dict(last, detail=n.get("detail", [])[-6:])
        time.sleep(5)
    return dict(last or {}, timed_out=True)


def t_ping(a):
    cfg = config()
    return api("POST", "/api/coding-agents/ping", {
        "message": a.get("message") or "", "title": a.get("title") or "", "source": a.get("source") or detect_harness(),
        "host": cfg["host"], "cwd": os.getcwd(), "session_id": a.get("session_id") or ""}, timeout=20, cfg=cfg)


SKIP_DIRS = {".git", "__pycache__", "node_modules", ".venv", "venv"}


def read_plugin_dir(path):
    base = os.path.realpath(os.path.expanduser(path))
    if not os.path.isfile(os.path.join(base, "joebro-plugin.json")):
        raise ValueError("no joebro-plugin.json in %s" % base)
    files = {}
    for root, dirs, names in os.walk(base):
        dirs[:] = [d for d in dirs if d not in SKIP_DIRS and not d.startswith(".")]
        for n in names:
            if n.startswith(".") or n.endswith(".pyc"):
                continue
            full = os.path.join(root, n)
            try:
                with open(full, encoding="utf-8") as f:
                    files[os.path.relpath(full, base)] = f.read()
            except UnicodeDecodeError:
                raise ValueError("%s is not text: plugins hold text files only (inline small images as SVG or data: URIs)" % full)
    return files


def t_plugin_spec(a):
    return api("GET", "/api/plugins/spec")


def t_plugin_list(a):
    d = api("GET", "/api/plugins")
    if d.get("ok") is False:
        return d
    keys = ("id", "slug", "name", "version", "is_enabled", "managed", "permission_mode", "contributes", "error", "description")
    return {"plugins": [{k: p.get(k) for k in keys} for p in d.get("plugins", [])]}


def t_plugin_install(a):
    if a.get("path"):
        try:
            files = read_plugin_dir(a["path"])
        except (OSError, ValueError) as e:
            return {"ok": False, "error": str(e)}
    elif isinstance(a.get("files"), dict):
        files = a["files"]
    else:
        return {"ok": False, "error": "give path (a local plugin folder) or files {relative path: text}"}
    body = {"files": files}
    if "enable" in a:
        body["enable"] = bool(a["enable"])
    return api("POST", "/api/plugins/install", body, timeout=90)


def t_plugin_source(a):
    return api("GET", "/api/plugins/%s/source" % q(a["id"]))


def t_plugin_test(a):
    return api("POST", "/api/plugins/%s/call" % q(a["id"]), {"tool": a["tool"], "arguments": a.get("arguments") or {}}, timeout=60)


def t_plugin_rollback(a):
    return api("POST", "/api/plugins/%s/rollback" % q(a["id"]), {})


# ----------------------------------------------------------------------------- MCP server
S = {"type": "string"}
ID = {"id": dict(S, description="agent id from coding_agents_list, e.g. code:mac:claude:<uuid>")}
PID = {"id": dict(S, description="plugin slug (e.g. plant-care) or id (plugin_plant_care)")}


def tool(name, desc, props, required=(), read=False, fn=None, destructive=False):
    return {"name": name, "description": desc, "fn": fn,
            "inputSchema": {"type": "object", "properties": props, "required": list(required), "additionalProperties": False},
            "annotations": {"readOnlyHint": read, "destructiveHint": destructive, "openWorldHint": True}}


