         {"id": S, "reason": S}, ["id"], fn=t_forget),
    tool("memory_project_brief", "The short memory brief for this project (the same one given at session start).", {}, read=True, fn=t_brief),
    tool("night_shift_add", "Queue a coding task for JoeBro Night Shift: it runs unattended overnight in its own git worktree and waits for the user's review in the morning. Never pushes.",
         {"prompt": S, "repo": dict(S, description="repo path; default: this one"), "title": S,
          "agent": {"type": "string", "enum": ["claude", "codex", "opencode", "any"]}, "model": S, "test_command": S,
          "window_start": dict(S, description="HH:MM"), "window_end": dict(S, description="HH:MM")}, ["prompt"], fn=t_night_add),
    tool("night_shift_list", "Night Shift tasks that are queued, running or waiting for review.", {}, read=True, fn=t_night_list),
    tool("night_shift_cancel", "Cancel a queued Night Shift task (or stop a running one; its worktree is kept).", {"id": S}, ["id"], fn=t_night_cancel),
    tool("joebro_plugin_spec", "The JoeBro plugin standard (joebro.plugin/1): manifest, python tools, UI panels with the joebro.call bridge, install rules. Read it before building or editing a JoeBro plugin.", {}, read=True, fn=t_plugin_spec),
