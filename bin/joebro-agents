    tool("memory_remember", "Save ONE durable fact about this project for every future agent session: a decision, a convention, a gotcha, or how to run/test something. One sentence. Not progress notes, not task summaries, never secrets. Duplicates are merged for you.",
         {"text": S, "topic": dict(S, description="one word, e.g. testing, deploy, style"),
          "kind": {"type": "string", "enum": ["fact", "decision", "convention", "gotcha", "howto"]},
          "scope": {"type": "string", "enum": ["project", "global"], "description": "global = true for every repo"}}, ["text"], fn=t_remember),
    tool("memory_supersede", "A remembered fact has changed: replace it with the new wording. The old one is kept as history.",
         {"id": dict(S, description="fact id from memory_recall"), "text": S, "reason": S}, ["id", "text"], fn=t_supersede),
